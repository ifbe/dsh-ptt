{
  "name": "dsh-ptt",
  "version": "0.2.2",
  "description": "极简对讲机插件：手柄A键按住说话(ASR->DSH会话)，B键语音命令(stop/reset/model/status/help/compact/goal)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "session.js",
    "speaker.js",
    "asr.js",
    "gamepad.js",
    "gamepad.py",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "requirements.txt",
    "ws.js",
    "out.js"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  }
}
